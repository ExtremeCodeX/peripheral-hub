{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Peripheral Hub",
  "version": "0.2.3",
  "identifier": "local.peripheralhub.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Peripheral Hub",
      "decorations": false,
      "width": 900,
      "height": 600,
      "minWidth": 360,
      "minHeight": 400
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false }
}
