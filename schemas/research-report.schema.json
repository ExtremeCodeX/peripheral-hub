{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peripheral-hub.local/schemas/research-report.schema.json",
  "title": "Peripheral Hub DRA research report",
  "description": "Sanitized `report.json` shape. The Rust typed/semantic validator is authoritative; this schema documents the exported contract and contains no payload contents beyond aggregate byte values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_schema_version", "generated_at_unix", "session", "analysis"],
  "properties": {
    "report_schema_version": { "const": 1 },
    "generated_at_unix": { "type": "integer", "minimum": 0 },
    "session": { "$ref": "#/$defs/session" },
    "analysis": { "$ref": "#/$defs/analysis" }
  },
  "$defs": {
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_schema_version",
        "id",
        "name",
        "created_at_unix",
        "device",
        "goal",
        "consent",
        "captures"
      ],
      "properties": {
        "session_schema_version": { "const": 1 },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "created_at_unix": { "type": "integer", "minimum": 0 },
        "device": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model"],
          "properties": {
            "model": { "type": "string", "minLength": 1, "maxLength": 128 },
            "firmware": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 }
          }
        },
        "software": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "sha256": {
              "type": ["string", "null"],
              "pattern": "^[0-9a-fA-F]{64}$"
            }
          }
        },
        "goal": { "type": "string", "minLength": 1, "maxLength": 512 },
        "consent": { "const": true },
        "captures": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "source", "event_count", "imported_at_unix"],
            "properties": {
              "file": {
                "type": "string",
                "pattern": "^capture-[0-9]{4}\\.json$"
              },
              "source": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
              },
              "description": {
                "type": ["string", "null"],
                "minLength": 1,
                "maxLength": 512
              },
              "event_count": { "type": "integer", "minimum": 1, "maximum": 20000 },
              "reordered": { "type": "boolean" },
              "imported_at_unix": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "group_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "transfer", "interface", "payload_len"],
      "properties": {
        "direction": { "enum": ["in", "out"] },
        "transfer": { "enum": ["control", "interrupt", "bulk"] },
        "interface": { "type": "integer", "minimum": 0, "maximum": 255 },
        "report_id": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 255
        },
        "payload_len": { "type": "integer", "minimum": 0, "maximum": 4096 }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_schema_version",
        "session_id",
        "generated_at_unix",
        "capture_count",
        "event_count",
        "reordered",
        "groups",
        "variable_offsets",
        "hypotheses",
        "limitations"
      ],
      "properties": {
        "analysis_schema_version": { "const": 1 },
        "session_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "generated_at_unix": { "type": "integer", "minimum": 0 },
        "capture_count": { "type": "integer", "minimum": 1, "maximum": 32 },
        "event_count": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "reordered": { "type": "boolean" },
        "groups": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "count", "distinct_payloads", "actions"],
            "properties": {
              "key": { "$ref": "#/$defs/group_key" },
              "count": { "type": "integer", "minimum": 1 },
              "distinct_payloads": { "type": "integer", "minimum": 1 },
              "actions": {
                "type": "array",
                "items": { "type": "string", "minLength": 1, "maxLength": 128 }
              }
            }
          }
        },
        "variable_offsets": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["group", "offset", "values", "action_values"],
            "properties": {
              "group": { "$ref": "#/$defs/group_key" },
              "offset": { "type": "integer", "minimum": 0 },
              "values": {
                "type": "array",
                "minItems": 2,
                "items": { "type": "integer", "minimum": 0, "maximum": 255 }
              },
              "action_values": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["action", "value", "count"],
                  "properties": {
                    "action": { "type": "string", "minLength": 1, "maxLength": 128 },
                    "value": { "type": "integer", "minimum": 0, "maximum": 255 },
                    "count": { "type": "integer", "minimum": 1 }
                  }
                }
              }
            }
          }
        },
        "hypotheses": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["confidence", "kind", "statement"],
            "properties": {
              "confidence": {
                "enum": ["confirmed_on_hardware", "inferred", "unverified"]
              },
              "kind": {
                "enum": ["action_offset", "variable_offset", "repeated_payload"]
              },
              "statement": { "type": "string", "minLength": 1, "maxLength": 1024 },
              "group": {
                "oneOf": [{ "$ref": "#/$defs/group_key" }, { "type": "null" }]
              },
              "offset": { "type": ["integer", "null"], "minimum": 0 }
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        }
      }
    }
  }
}
