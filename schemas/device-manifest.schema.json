{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peripheral-hub.local/schemas/device-manifest.schema.json",
  "title": "Peripheral Hub declarative device manifest",
  "description": "Schema version 1 of the bounded declarative driver manifest. A manifest only selects operations the interpreter models; it can never execute code, name a shell command, or describe firmware/persistent-memory operations. Semantic rules that JSON Schema cannot express (overlap, effect mapping, capability consistency) are enforced by the interpreter and documented in each property.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "model", "match", "capabilities", "operations"],
  "properties": {
    "manifest_version": {
      "description": "Manifest schema version. Must equal 1.",
      "type": "integer",
      "const": 1
    },
    "model": { "$ref": "#/$defs/model" },
    "match": {
      "description": "Matching evidence. Each entry is an exact conjunction; interface_number or usage is required beyond VID/PID.",
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/matchRule" }
    },
    "capabilities": { "$ref": "#/$defs/capabilities" },
    "operations": {
      "description": "Modeled operations. At least one is required and set_lighting zones must be unique and declared.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "sdk_major", "sdk_minor"],
      "properties": {
        "id": {
          "description": "Stable model token: 1..128 bytes of ASCII alphanumerics, '-', '_', '.', or ':'.",
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sdk_major": {
          "description": "Implemented SDK contract major version; must equal 1.",
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "sdk_minor": {
          "description": "Implemented SDK contract minor version; must not exceed the running SDK minor.",
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "matchRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor_id", "product_id", "transport"],
      "properties": {
        "vendor_id": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "product_id": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "transport": { "enum": ["hid", "usb"] },
        "interface_number": { "type": "integer", "minimum": 0, "maximum": 255 },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["page", "usage"],
          "properties": {
            "page": { "type": "integer", "minimum": 0, "maximum": 65535 },
            "usage": { "type": "integer", "minimum": 0, "maximum": 65535 }
          }
        },
        "product": { "type": "string", "minLength": 1, "maxLength": 256 },
        "firmware_version": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "anyOf": [{ "required": ["interface_number"] }, { "required": ["usage"] }]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lighting": {
          "type": "object",
          "additionalProperties": false,
          "required": ["zones", "brightness", "effects"],
          "properties": {
            "zones": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 128 }
            },
            "brightness": { "type": "boolean" },
            "effects": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "uniqueItems": true,
              "items": { "enum": ["static", "breathing", "color_cycle"] }
            }
          }
        },
        "display": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "formats", "max_frames_per_second", "max_frame_bytes"],
          "properties": {
            "width": { "type": "integer", "minimum": 1, "maximum": 4096 },
            "height": { "type": "integer", "minimum": 1, "maximum": 4096 },
            "formats": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "uniqueItems": true,
              "items": { "enum": ["rgb888", "rgb565"] }
            },
            "max_frames_per_second": { "type": "integer", "minimum": 1, "maximum": 240 },
            "max_frame_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 }
          }
        },
        "buttons": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "remapping"],
          "properties": {
            "count": { "type": "integer", "minimum": 1, "maximum": 1024 },
            "remapping": { "type": "boolean" }
          }
        },
        "macros": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_actions", "max_delay_ms"],
          "properties": {
            "max_actions": { "type": "integer", "minimum": 1, "maximum": 4096 },
            "max_delay_ms": { "type": "integer", "minimum": 1, "maximum": 60000 }
          }
        },
        "profiles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_profiles"],
          "properties": {
            "max_profiles": { "type": "integer", "minimum": 1, "maximum": 1024 }
          }
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "zone", "report"],
      "properties": {
        "kind": { "const": "set_lighting" },
        "zone": {
          "description": "Must be declared in capabilities.lighting.zones and unique across operations.",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "report": { "$ref": "#/$defs/report" }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "report_id", "length", "timeout_ms", "max_rate_per_second", "fields"],
      "properties": {
        "kind": {
          "description": "Report direction. 'input' is rejected: manifests cannot read.",
          "enum": ["output", "feature"]
        },
        "report_id": { "type": "integer", "minimum": 0, "maximum": 255 },
        "length": {
          "description": "Exact payload length in bytes, excluding the report ID (1..64).",
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 30000 },
        "max_rate_per_second": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "fields": {
          "description": "Byte layout. Offsets must be unique and within length; each entry sets exactly one of fill or source; sources are unique.",
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        },
        "effect": { "$ref": "#/$defs/effectEncoding" }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset"],
      "properties": {
        "offset": { "type": "integer", "minimum": 0, "maximum": 63 },
        "fill": { "type": "integer", "minimum": 0, "maximum": 255 },
        "source": { "enum": ["red", "green", "blue", "brightness"] }
      },
      "oneOf": [{ "required": ["fill"] }, { "required": ["source"] }]
    },
    "effectEncoding": {
      "description": "Required when any declared effect is not static; must map every declared effect to a unique byte value.",
      "type": "object",
      "additionalProperties": false,
      "required": ["offset", "values"],
      "properties": {
        "offset": { "type": "integer", "minimum": 0, "maximum": 63 },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["effect", "value"],
            "properties": {
              "effect": { "enum": ["static", "breathing", "color_cycle"] },
              "value": { "type": "integer", "minimum": 0, "maximum": 255 }
            }
          }
        }
      }
    }
  }
}
