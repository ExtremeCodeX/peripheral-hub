{
  "name": "peripheral-hub",
  "version": "0.2.2",
  "license": "Apache-2.0",
  "private": true,
  "workspaces": ["apps/desktop"],
  "scripts": {
    "dev": "npm run tauri --workspace @peripheral-hub/desktop -- dev",
    "dev:web": "npm run dev --workspace @peripheral-hub/desktop",
    "build": "npm run tauri --workspace @peripheral-hub/desktop -- build --no-bundle",
    "build:web": "npm run build --workspace @peripheral-hub/desktop",
    "typecheck": "npm run typecheck --workspace @peripheral-hub/desktop",
    "test": "npm run test --workspace @peripheral-hub/desktop --",
    "check:rust": "cargo check --locked --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "test:rust": "python3 -B tools/test-rust.py",
    "test:python": "python3 -B -m unittest discover -s tools/tests -v && python3 -B -m unittest discover -s apps/desktop/src-tauri/tests -v && python3 -B -m unittest discover -s community/integration-starter/tests -v",
    "test:catalog": "python3 -B tools/build-catalog.py --check",
    "fmt:rust": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml -- --check"
  },
  "engines": { "node": ">=22.12.0", "npm": ">=10" }
}
